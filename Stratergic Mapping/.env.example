# Shared
APP_ENV=local
APP_NAME=7Cs Disease Intelligence Platform

# Backend
API_HOST=0.0.0.0
API_PORT=8005
DATABASE_URL=postgresql+psycopg://stratergic:stratergic@postgres:5432/stratergic_mapping
REDIS_URL=redis://redis:6379/0

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
LIVE_CONNECTORS_ENABLED=false

# Local vector DB for uploaded PDF/PPTX chunks
VECTOR_DB_PATH=chroma_db
VECTOR_COLLECTION_NAME=stratergic_upload_chunks
VECTOR_EMBEDDING_DIMENSIONS=1536

# Object storage
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_BUCKET=stratergic-mapping
OBJECT_STORAGE_PUBLIC_URL=http://localhost:9000

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8005

# Optional connector keys/config
NCBI_EMAIL=
NCBI_API_KEY=
NCBI_RETMAX=100
NCBI_REQUEST_DELAY_SECONDS=0.5
CLINICAL_TRIALS_PAGE_SIZE=100
WEB_SEARCH_RESULTS_PER_SOURCE=100
WEB_REQUEST_DELAY_SECONDS=0.5
INTERNAL_UPLOAD_TOP_K=50
EXTERNAL_REQUEST_TIMEOUT_SECONDS=30
EXTERNAL_REQUEST_RETRIES=4
BING_SEARCH_API_KEY=
SERPAPI_API_KEY=
