\f0\fs24 \cf0 openapi: 3.1.0\
info:\
  title: DefaultSearch\
  description: This API allows querying text embeddings from a Snowflake index called TABLE_NAME.\
  version: v1.0.0\
servers:\
  - url: https://web-service.onrender.com\
paths:\
  /query:\
    post:\
      summary: Get Answer with Context\
      description: Receive a query and return an answer generated by GPT based on retrieved contextual information.\
      operationId: GetAnswerWithContext\
      requestBody:\
        description: Request body for getting an answer with context.\
        required: true\
        content:\
          application/json:\
            schema:\
              $ref: "#/components/schemas/QueryRequest"\
      responses:\
        "200":\
          description: Successful response with GPT-generated answer and context information.\
          content:\
            application/json:\
              schema:\
                $ref: "#/components/schemas/QueryResponse"\
      x-openai-isConsequential: false\
components:\
  schemas:\
    QueryRequest:\
      type: object\
      properties:\
        query_text:\
          type: string\
          description: User's query to retrieve context for.\
        top_k:\
          type: integer\
          description: Number of top results to retrieve.\
          default: 15\
        table_name:\
          type: string\
          description: Name of the Snowflake table to query.\
          default: TABLE_NAME\
      required:\
        - query_text\
        - table_name\
    QueryResponse:\
      type: object\
      properties:\
        context:\
          type: array\
          description: List of retrieved contexts with metadata for transparency and reference.\
          items:\
            type: object\
            properties:\
              page_content:\
                type: string\
                description: The text content of the retrieved context.\
              metadata:\
                type: object\
                description: Dynamic metadata associated with the document.\
                additionalProperties: true\
      required:\
        - context\
}