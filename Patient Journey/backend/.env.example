# ── Python backend env ───────────────────────────────────────────
# Copy this file to .env and fill in your values

# OpenAI (for embeddings + GPT-4o generation)
OPENAI_API_KEY=sk-...

# Tavily (for web search tool in the pipeline)
TAVILY_API_KEY=tvly-...

# Snowflake
SNOWFLAKE_ACCOUNT=your_account.snowflakecomputing.com
SNOWFLAKE_USER=your_user
SNOWFLAKE_WAREHOUSE=your_warehouse
SNOWFLAKE_DATABASE=your_database
SNOWFLAKE_SCHEMA=your_schema
SNOWFLAKE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=your_passphrase_or_leave_empty
