{
  "openapi": "3.1.0",
  "info": {
    "title": "PFIZER HEMONC Knowledge Search",
    "description": "Searches the isolated PFIZER HEMONC Snowflake knowledge corpus.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://knowledge-hub-search-api.onrender.com"
    }
  ],
  "paths": {
    "/query/": {
      "post": {
        "operationId": "searchPfizerHemonc",
        "summary": "Search PFIZER HEMONC evidence",
        "description": "Semantically searches published evidence indexed only in COMMUNICATIONS__EU__DER__DEV.KNOWLEDGE_HUB. Use CHUNK_TEXT as evidence.",
        "x-openai-isConsequential": false,
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "query_text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000,
                    "description": "A focused semantic query for PFIZER HEMONC evidence."
                  },
                  "top_k": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 8,
                    "default": 3,
                    "description": "Number of evidence passages to retrieve."
                  }
                },
                "required": [
                  "query_text"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Relevant PFIZER HEMONC passages.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "context": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/EvidencePassage"
                      }
                    }
                  },
                  "required": [
                    "context"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key."
          },
          "422": {
            "description": "Invalid request body."
          },
          "502": {
            "description": "Snowflake Cortex Search failed."
          },
          "503": {
            "description": "Search service configuration is unavailable."
          }
        }
      }
    },
    "/research/query/": {
      "post": {
        "operationId": "searchPfizerResearch",
        "summary": "Search PubMed or clinical trials",
        "description": "Uses the user query to discover relevant IDs, then returns authoritative records from COMPILE_ADD_ON.PUBMED_DETAILS.PUBLICATIONS or CLINICAL_TRIAL_DETAILS.",
        "x-openai-isConsequential": false,
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "source": {
                    "type": "string",
                    "enum": [
                      "pubmed",
                      "clinical_trials"
                    ],
                    "description": "External governed source to query."
                  },
                  "query_text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000,
                    "description": "Dynamic topic supplied or implied by the user."
                  },
                  "top_k": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10,
                    "default": 5
                  }
                },
                "required": [
                  "source",
                  "query_text"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authoritative PubMed or clinical-trial records from Snowflake."
          },
          "401": {
            "description": "Missing or invalid API key."
          },
          "422": {
            "description": "Invalid source or request body."
          },
          "502": {
            "description": "Discovery or Snowflake lookup failed."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    },
    "schemas": {
      "EvidencePassage": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "CHUNK_ID": {
            "type": "string"
          },
          "CHUNK_TEXT": {
            "type": "string",
            "description": "The retrieved passage and primary evidence."
          },
          "DOCUMENT_ID": {
            "type": "string"
          },
          "TITLE": {
            "type": "string"
          },
          "ORIGINAL_FILENAME": {
            "type": "string"
          },
          "PAGE_FROM": {
            "type": [
              "integer",
              "null"
            ]
          },
          "PAGE_TO": {
            "type": [
              "integer",
              "null"
            ]
          },
          "SECTION_PATH": {
            "type": [
              "string",
              "null"
            ]
          },
          "DOCUMENT_TYPE": {
            "type": [
              "string",
              "null"
            ]
          },
          "LANGUAGE": {
            "type": [
              "string",
              "null"
            ]
          },
          "EVIDENCE_TYPE": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "CHUNK_ID",
          "CHUNK_TEXT",
          "DOCUMENT_ID"
        ]
      }
    }
  }
}
