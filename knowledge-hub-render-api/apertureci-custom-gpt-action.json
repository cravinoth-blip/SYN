{
  "openapi": "3.1.0",
  "info": {
    "title": "APERTURECI ASUNDEXIAN vs MILVEXIAN Search",
    "description": "Searches all governed APERTURECI schema data while keeping ASUNDEXIAN primary and MILVEXIAN the principal competitor.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://knowledge-hub-search-api.onrender.com"
    }
  ],
  "paths": {
    "/apertureci/query/": {
      "post": {
        "operationId": "searchApertureCI",
        "summary": "Search ASUNDEXIAN and MILVEXIAN evidence",
        "description": "Searches governed APERTURECI vectors, structured analyses, news, workbook sections, knowledge, and fixed whole-schema records.",
        "x-openai-isConsequential": false,
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "primary_asset": {
                    "type": "string",
                    "enum": [
                      "ASUNDEXIAN"
                    ],
                    "default": "ASUNDEXIAN",
                    "description": "Fixed primary asset. Always use ASUNDEXIAN."
                  },
                  "competitor": {
                    "type": "string",
                    "enum": [
                      "MILVEXIAN"
                    ],
                    "default": "MILVEXIAN",
                    "description": "Fixed sole competitor. Always use MILVEXIAN."
                  },
                  "source": {
                    "type": "string",
                    "enum": [
                      "dexi",
                      "publications",
                      "clinical_trials",
                      "competitor_maps",
                      "trial_comparisons",
                      "knowledge",
                      "news",
                      "competitor_analysis",
                      "schema"
                    ],
                    "description": "One governed APERTURECI evidence surface to search. Use schema for fixed whole-schema search; arbitrary table names are never accepted."
                  },
                  "query_text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000,
                    "description": "Focused evidence query that explicitly includes ASUNDEXIAN, MILVEXIAN, or a known development-code alias."
                  },
                  "top_k": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 8,
                    "default": 4,
                    "description": "Maximum records returned from each selected evidence surface."
                  },
                  "context_id": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 255,
                    "description": "Optional APERTURECI context ID when the user explicitly wants one saved context."
                  }
                },
                "required": [
                  "primary_asset",
                  "competitor",
                  "source",
                  "query_text"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Governed evidence and any source-level retrieval warnings.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "primary_asset": {
                      "type": "string",
                      "enum": [
                        "ASUNDEXIAN"
                      ]
                    },
                    "competitor": {
                      "type": "string",
                      "enum": [
                        "MILVEXIAN"
                      ]
                    },
                    "source": {
                      "type": "string"
                    },
                    "query": {
                      "type": "string"
                    },
                    "result_count": {
                      "type": "integer"
                    },
                    "latency_ms": {
                      "type": "integer"
                    },
                    "source_errors": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "source": {
                            "type": "string"
                          },
                          "error": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "source",
                          "error"
                        ]
                      }
                    },
                    "context": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ApertureEvidence"
                      }
                    }
                  },
                  "required": [
                    "primary_asset",
                    "competitor",
                    "source",
                    "query",
                    "result_count",
                    "source_errors",
                    "context"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key."
          },
          "422": {
            "description": "Invalid source or request body."
          },
          "502": {
            "description": "APERTURECI retrieval could not connect to Snowflake."
          },
          "503": {
            "description": "Required service configuration is unavailable."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    },
    "schemas": {
      "ApertureEvidence": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "SOURCE_TYPE": {
            "type": "string",
            "description": "Governed source category."
          },
          "RECORD_ID": {
            "type": "string",
            "description": "Stable source record or chunk identifier."
          },
          "TITLE": {
            "type": "string"
          },
          "TEXT": {
            "type": "string",
            "description": "Primary evidence text. Use this as the factual basis."
          },
          "URL": {
            "type": "string",
            "description": "PubMed, DOI, or ClinicalTrials.gov URL when available."
          },
          "CONTEXT_ID": {
            "type": "string",
            "description": "APERTURECI saved-context identifier when applicable."
          },
          "METADATA": {
            "type": "object",
            "additionalProperties": true
          },
          "SCORE": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": true,
            "description": "Cortex relevance scoring data when available."
          }
        },
        "required": [
          "SOURCE_TYPE",
          "RECORD_ID",
          "TITLE",
          "TEXT"
        ]
      }
    }
  }
}
